{
  "name": "agentic-tasks",
  "version": "0.13.1",
  "description": "Task boards where people and agents claim and finish work.",
  "keywords": [
    "tasks",
    "kanban",
    "todo",
    "project-management",
    "agents",
    "mcp",
    "cli",
    "collaboration"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-tasks.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.itsryanarmani/agentic-tasks",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/embed.css",
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "bin": {
    "agentic-tasks": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup && node scripts/build-ui.mjs",
    "prepack": "npm run clean && npm run build",
    "deploy:demo": "npm run build && WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.demo.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "npm run build && WRANGLER_SEND_METRICS=false wrangler dev --port 8791",
    "dev:smoke": "npm run build && node scripts/dev-smoke.mjs 8791 /api/v1/tasks/health",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentic-design": "^0.10.0",
    "agentic-identity": "^0.12.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "peerDependencies": {
    "agentic-identity": ">=0.10.0 <1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "agentic-design": {
      "zod": "^4.6.6"
    }
  }
}